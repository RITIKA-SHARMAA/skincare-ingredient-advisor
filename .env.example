# Copied to .env by `make up`. Only the API reads this file.

# rules = built-in catalogue explanations (no GCP needed); vertex = Gemini on Vertex AI.
LLM_PROVIDER=rules
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash

# local = label photos stored under STORAGE_ROOT; gcs = signed Cloud Storage URLs.
STORAGE_BACKEND=local
STORAGE_BUCKET=
PUBLIC_API_BASE_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:3000
MAX_INGREDIENTS_PER_REQUEST=100
